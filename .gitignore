.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# secrets
.env

# raw downloads are untrusted third-party data, never committed
data/raw/

# raw experiment output and LLM cache (large, regenerable); keep summaries in results/summary/
results/raw/
results/cache/
!results/summary/

third_party/*
!third_party/README.md

# talk transcripts are not ours to redistribute
docs/talks/raw/

# third-party report texts kept for reading only
docs/literature/*_report.txt
# derived tables from third-party data
results/feas_t2/
results/pilot_kin_mrt/

# Phase 3 training data: organism files are over 50 MB; raw teacher episodes are regenerable
# from the LLM cache (experiments/make_training_data.py). The manifest and the
# .meta.jsonl sidecars (episode, player and turn of every row) are committed.
results/train/*.jsonl
!results/train/*.meta.jsonl
results/train/raw/
results/train/tmp/
results/train/gen.log
results/serve/
results/models/
report/content_filled.md

# third-party documents shared at the sprint, kept for reading only
docs/talks/gutenberg_*.txt
